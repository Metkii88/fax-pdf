# /var/spool/hylafax/etc/DialRules — нормализация номеров при дозвоне.
# Приводим российские номера к формату 8W10 цифр; международные — через 00.

Rule  "+7([0-9]{10})"       "0$1"     # +7XXXXXXXXXX -> 0XXXXXXXXXX (local)
Rule  "^(8|7)([0-9]{10})$"  "0$2"
Rule  "^\+([0-9]{6,15})$"   "00$1"    # прочие международные
Rule  ".*"                  "$1"
